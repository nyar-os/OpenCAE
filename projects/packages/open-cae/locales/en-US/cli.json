{
    "cli": {
        "intro": "open-cae - OpenCAE truss/beam linear-static, modal and buckling solver (2D/3D)",
        "usage": [
            "Usage:",
            "  open-cae create <file.ocae> [--units mm|m] [--dimension 2|3]",
            "  open-cae node add <file> --id <id> --x <x> --y <y> [--z <z>]",
            "  open-cae node update <file> --id <id> [--x <x>] [--y <y>] [--z <z>]",
            "  open-cae node mass <file> --id <id> --mass <mass>",
            "  open-cae node temperature <file> --id <id> [--temperature <t>] [--clear]",
            "  open-cae node heat <file> --id <id> --heat <w>",
            "  open-cae node remove <file> --id <id>",
            "  open-cae node displacement <file> --id <id>",
            "  open-cae element add <file> --id <id> --from <node> --to <node> [--E <E>] [--A <A>]",
            "                    [--kind truss|beam] [--I <I>] [--w <w>] [--w2 <w2>] [--dt <dT>]",
            "                    [--convection <h>] [--perimeter <P>] [--tension-only]",
            "  open-cae element update <file> --id <id> [--from <node>] [--to <node>]",
            "                    [--w <w>] [--w2 <w2>] [--w-from <s>] [--w-to <s>]",
            "                    [--dt <dT>] [--dt-grad <dT>] [--convection <h>] [--perimeter <P>]",
            "                    [--clear-load] [--clear-temperature]",
