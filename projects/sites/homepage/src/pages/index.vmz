<template>
    <SiteShell page="home">
        <section class="hero">
            <div class="hero__copy">
                <span class="tag">Linear elastic · closed-form regression · unreleased</span>
                <h1>
                    Truss and beam results<br />
                    that survive a closed-form check.
                </h1>
                <p class="hero__sub">
                    OpenCAE keeps nodes, elements, supports and loads in one
                    <code>.ocae</code> document. A single Rust session owns
                    validation, assembly, solving and export; the CLI, Node-API
                    addon and TypeScript SDK are wrappers over that same core.
                    Unimplemented routes return
                    <code>capability/not-implemented</code> instead of an
                    approximation.
                </p>

                <dl class="spec">
                    <div class="spec__row">
                        <dt>Scope</dt>
                        <dd>2D beam · 2D / 3D truss</dd>
                    </div>
                    <div class="spec__row">
                        <dt>Analysis</dt>
                        <dd>static · modal · buckling · spectrum · harmonic</dd>
                    </div>
                    <div class="spec__row">
                        <dt>Units</dt>
                        <dd>N · mm · MPa or N · m · Pa, no implicit conversion</dd>
                    </div>
                    <div class="spec__row">
                        <dt>Output</dt>
                        <dd>CSV · legacy VTK · Markdown · HTML report</dd>
                    </div>
                </dl>

                <div class="hero__cta">
                    <Link to="FeaturesPage" class="btn btn--primary">
                        Open feature index
                    </Link>
                    <Link to="RoadmapPage" class="btn btn--ghost">
                        Read the gate log
                    </Link>
                </div>
            </div>

            <div class="sheet" aria-hidden="true">
                <div class="sheet__head">
                    <span class="sheet__no">SHEET 01 / 03</span>
                    <span>STATIC · LINEAR ELASTIC</span>
                    <span class="sheet__rev">REV 0</span>
                </div>

                <div class="draw">
                    <div class="draw__canvas">
                        <span class="axis axis--h"></span>
                        <span class="axis axis--v"></span>

                        <i class="member member--comp" style="left: 20px; top: 139px; width: 170px; transform: rotate(-45deg)"></i>
                        <i class="member member--comp" style="left: 260px; top: 139px; width: 170px; transform: rotate(-135deg)"></i>
                        <i class="member member--tens" style="left: 20px; top: 139px; width: 240px"></i>

                        <i class="node" style="left: 16px; top: 136px"></i>
                        <i class="node" style="left: 256px; top: 136px"></i>
                        <i class="node" style="left: 136px; top: 16px"></i>

                        <span class="node-label" style="left: 1px; top: 145px">n1</span>
                        <span class="node-label" style="left: 266px; top: 145px">n2</span>
                        <span class="node-label" style="left: 119px; top: 1px">n3</span>

                        <span class="support support--pin" style="left: 12px; top: 144px"></span>
                        <span class="hatch" style="left: 5px; top: 155px; width: 32px"></span>

                        <span class="support support--roller" style="left: 256px; top: 144px"></span>
                        <span class="hatch" style="left: 249px; top: 155px; width: 24px"></span>

                        <span class="load">
                            <i class="load__stem"></i>
                            <i class="load__head"></i>
                        </span>
                        <span class="load-label">−1.0 kN</span>

                        <span class="force-label force-label--comp" style="left: 48px; top: 58px">C −707.1</span>
                        <span class="force-label force-label--tens" style="left: 92px; top: 146px">T +500.0</span>

                        <span class="dim" style="left: 20px; top: 166px; width: 240px"></span>
                        <span class="dim__tick" style="left: 20px; top: 162px"></span>
                        <span class="dim__tick" style="left: 260px; top: 162px"></span>
                        <span class="dim-label">1000 mm</span>
                    </div>
                </div>

                <div class="readout">
                    <div class="readout__row">
                        <span>max |u|</span>
                        <b>0.0336718</b>
                        <i>mm</i>
                    </div>
                    <div class="readout__row">
                        <span>axial N</span>
                        <b>−707.1068</b>
                        <i>N</i>
                    </div>
                    <div class="readout__row">
                        <span>stress σ</span>
                        <b>−7.0711</b>
                        <i>MPa</i>
                    </div>
                    <div class="readout__row readout__row--ok">
                        <span>equilibrium</span>
                        <b>PASS</b>
                        <i>ΣR + ΣF = 0</i>
                    </div>
                </div>

                <div class="sheet__foot">
                    <span>$ ocae solve demo.ocae --analysis static</span>
                    <span>exit 0</span>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">01</span>Capability matrix</h2>
                <p>What this build actually solves, and what fails with a stable error code.</p>
            </div>
            <div class="table-wrap">
                <table class="matrix">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Analysis</th>
                            <th>Method</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="row in capabilityRows" :key="row.code">
                            <td class="name">{{ row.code }}</td>
                            <td>{{ row.analysis }}</td>
                            <td class="method">{{ row.method }}</td>
                            <td><span :class="statusChip(row.status)">{{ row.status }}</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="table-note">
                The machine-readable matrix is printed by
                <code>ocae capabilities</code> and matches actual behaviour at
                every entry point.
            </p>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">02</span>One core, four surfaces</h2>
                <p>No solver is reimplemented in a binding.</p>
            </div>
            <div class="table-wrap">
                <table class="matrix matrix--surfaces">
                    <thead>
                        <tr>
                            <th>Surface</th>
                            <th>Package</th>
                            <th>Responsibility</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="name">Rust session</td>
                            <td class="name">cae-model</td>
                            <td>Document I/O, editing, validation, assembly, solving and export.</td>
                        </tr>
                        <tr>
                            <td class="name">Node-API</td>
                            <td class="name">cae-napi</td>
                            <td>Orthogonal functions over the session; each returns JSON.</td>
                        </tr>
                        <tr>
                            <td class="name">TypeScript SDK</td>
                            <td class="name">@wae/open-cae</td>
                            <td><code>new OpenCAE()</code> session, <code>CaeDocument</code> documents, atomic save.</td>
                        </tr>
                        <tr>
                            <td class="name">CLI</td>
                            <td class="name">ocae</td>
                            <td>Argument parsing, JSON output and exit codes <code>0</code> / <code>1</code> / <code>2</code> only.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">03</span>Workflow</h2>
                <p>Declare, assemble, solve, recover. Every edit writes the document atomically.</p>
            </div>
            <ol class="flow">
                <li class="flow-step">
                    <span class="flow-index">01</span>
                    <h3>Declare</h3>
                    <p>Create an <code>.ocae</code> file with units, dimension, nodes, elements and material.</p>
                    <span class="chip chip--available">available</span>
                </li>
                <li class="flow-step">
                    <span class="flow-index">02</span>
                    <h3>Assemble</h3>
                    <p>Add rigid, spring, inclined or prescribed supports, nodal loads, member loads and gravity.</p>
                    <span class="chip chip--available">available</span>
                </li>
                <li class="flow-step">
                    <span class="flow-index">03</span>
                    <h3>Solve</h3>
                    <p>Run static, modal, buckling, response-spectrum, harmonic or staged analysis.</p>
                    <span class="chip chip--available">available</span>
                </li>
                <li class="flow-step">
                    <span class="flow-index">04</span>
                    <h3>Recover</h3>
                    <p>Read reactions, N/V/M diagrams, stresses, deflections and write CSV, VTK, Markdown or HTML.</p>
                    <span class="chip chip--available">available</span>
                </li>
            </ol>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">04</span>Closed-form benchmarks</h2>
                <p>Reference values are analytical, not a snapshot of the solver.</p>
            </div>
            <div class="table-wrap">
                <table class="matrix matrix--bench">
                    <thead>
                        <tr>
                            <th>Case</th>
                            <th>Closed form</th>
                            <th>Reference output</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="name">2-bar truss, apex −1000 N</td>
                            <td class="method">N = −P / (2 sin θ)</td>
                            <td class="num">−707.1068 N</td>
                        </tr>
                        <tr>
                            <td class="name">2-bar truss, apex displacement</td>
                            <td class="method">δ = P L / (2 E A sin² θ)</td>
                            <td class="num">−0.0336718 mm</td>
                        </tr>
                        <tr>
                            <td class="name">3D single bar, axial</td>
                            <td class="method">u = F L / (E A)</td>
                            <td class="num">−0.0476190 mm</td>
                        </tr>
                        <tr>
                            <td class="name">3D single bar, stress</td>
                            <td class="method">σ = F / A</td>
                            <td class="num">−10 MPa</td>
                        </tr>
                        <tr>
                            <td class="name">Propped cantilever settlement</td>
                            <td class="method">R = 3 E I δ / L³</td>
                            <td class="num">1e-12 rel</td>
                        </tr>
                        <tr>
                            <td class="name">Cantilever with tip spring</td>
                            <td class="method">δ = P / (3 E I / L³ + k)</td>
                            <td class="num">1e-12 rel</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="table-note">
                Settlement, spring and 3D-bar regressions assert a
                <code>1e-12</code> relative error against the closed form. Modal
                analysis uses a lumped mass matrix, so frequencies remain finite
                element approximations; the stated bounds live in the readme and
                tests.
            </p>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">05</span>Scope</h2>
                <p>A narrow solver with an explicit boundary.</p>
            </div>
            <div class="grid-2">
                <article class="card scope-card scope-card--in">
                    <span class="chip chip--available">in scope</span>
                    <h3>Implemented today</h3>
                    <ul>
                        <li>2D truss and 3D truss linear static analysis</li>
                        <li>2D Euler–Bernoulli beams with shear and moment diagrams</li>
                        <li>Rigid, elastic-spring, inclined roller and prescribed supports</li>
                        <li>Nodal loads and moments, uniform or trapezoidal member loads</li>
                        <li>Self-weight, uniform temperature change and through-depth gradient</li>
                        <li>Load combinations, modal, linear buckling and buckling per combination</li>
                        <li>Response spectrum, harmonic sweep and construction stages</li>
                        <li>Geometric-nonlinear truss analysis with load increments</li>
                        <li>Parametric sections: rectangle, circle, I, box, tube, channel</li>
                        <li>CSV, legacy VTK, Markdown and self-contained HTML reports</li>
                    </ul>
                </article>
                <article class="card scope-card scope-card--out">
                    <span class="chip chip--blocked">out of scope</span>
                    <h3>Rejected, not approximated</h3>
                    <ul>
                        <li>3D beam and 3D frame elements</li>
                        <li>Shell, membrane and solid elements</li>
                        <li>Material nonlinearity and beam / frame large displacement</li>
                        <li>Steady-state or transient heat transfer</li>
                        <li>Contact, prestress and dynamic time history</li>
                        <li>Abaqus <code>.inp</code> import and STEP export</li>
                        <li>Graphical interface and model viewport</li>
                    </ul>
                </article>
            </div>
        </section>

        <section class="status-band">
            <div>
                <span class="eyebrow">Build status</span>
                <h2>Solver core is real. The interface is the terminal.</h2>
                <p>
                    Create, edit, validate, solve and export a model today, then
                    compare the recovered values with the closed forms above.
                    There is no viewport: open the exported VTK in ParaView. Each
                    unimplemented route fails with
                    <code>capability/not-implemented</code> and exit code
                    <code>2</code>.
                </p>
            </div>
            <Link to="RoadmapPage" class="btn btn--ghost">Read the gate log</Link>
        </section>

        <p class="cta-line">
            Want the detailed surface?
            <Link to="FeaturesPage">Read the feature index</Link>
            .
        </p>
    </SiteShell>
</template>

<style>
.hero {
    display: grid;
    grid-template-columns: 1.06fr 0.94fr;
    gap: 40px;
    align-items: start;
    padding: 26px 0 4px;
}

.hero h1 {
    margin: 14px 0 16px;
    font-size: 35px;
}

.hero__sub {
    max-width: 560px;
    margin: 0 0 22px;
    color: var(--cae-muted);
    font-size: 15.5px;
}

.spec {
    margin: 0 0 24px;
    border-top: 1px solid var(--cae-line);
}

.spec__row {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 10px;
    padding: 6px 0;
    border-bottom: 1px solid var(--cae-line);
}

.spec dt {
    color: var(--cae-muted);
    font-family: var(--cae-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-top: 2px;
}

.spec dd {
    margin: 0;
    font-family: var(--cae-mono);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
}

.hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.sheet {
    border: 1px solid var(--cae-line-strong);
    background: var(--cae-surface);
    box-shadow: 6px 6px 0 rgba(16, 23, 28, 0.06);
}

.sheet__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 9px;
    border-bottom: 1px solid var(--cae-line-strong);
    background: var(--cae-surface-2);
    color: var(--cae-muted);
    font-family: var(--cae-mono);
    font-size: 8.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.sheet__no {
    color: var(--cae-ink);
    font-weight: 600;
}

.sheet__rev {
    margin-left: auto;
    padding: 0 5px;
    border: 1px solid var(--cae-line-strong);
    background: var(--cae-surface);
    color: var(--cae-ink);
}

.draw {
    padding: 10px 8px 6px;
    border-bottom: 1px solid var(--cae-line);
    background:
        linear-gradient(to right, rgba(16, 23, 28, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 23, 28, 0.05) 1px, transparent 1px);
    background-size: 12px 12px;
}

.draw__canvas {
    position: relative;
    width: 280px;
    height: 176px;
    margin: 0 auto;
}

.axis {
    position: absolute;
    background: var(--cae-line);
}

.axis--h {
    left: 0;
    top: 140px;
    width: 280px;
    height: 1px;
}

.axis--v {
    left: 140px;
    top: 8px;
    width: 1px;
    height: 146px;
    background: repeating-linear-gradient(
        to bottom,
        var(--cae-line) 0,
        var(--cae-line) 4px,
        transparent 4px,
        transparent 9px
    );
}

.member {
    position: absolute;
    height: 2px;
    transform-origin: 0 0;
}

.member--comp {
    background: var(--cae-accent);
}

.member--tens {
    background: var(--cae-ok);
}

.node {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 1px solid var(--cae-ink);
    background: var(--cae-surface);
    transform: rotate(45deg);
}

.node-label {
    position: absolute;
    color: var(--cae-muted);
    font-family: var(--cae-mono);
    font-size: 8px;
    letter-spacing: 0.04em;
}

.support {
    position: absolute;
    display: block;
}

.support--pin {
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 10px solid var(--cae-ink);
}

.support--roller {
    width: 8px;
    height: 8px;
    border: 1px solid var(--cae-ink);
    border-radius: 50%;
}

.hatch {
    position: absolute;
    height: 4px;
    border-top: 1px solid var(--cae-ink);
    background: repeating-linear-gradient(
        45deg,
        var(--cae-ink) 0,
        var(--cae-ink) 1px,
        transparent 1px,
        transparent 4px
    );
}

.load {
    position: absolute;
    left: 140px;
    top: 0;
    width: 1px;
    height: 16px;
}

.load__stem {
    position: absolute;
    left: 0;
    top: -2px;
    width: 1px;
    height: 12px;
    background: var(--cae-stop);
}

.load__head {
    position: absolute;
    left: -3px;
    top: 9px;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid var(--cae-stop);
}

.load-label {
    position: absolute;
    left: 150px;
    top: 4px;
    color: var(--cae-stop);
    font-family: var(--cae-mono);
    font-size: 8px;
}

.force-label {
    position: absolute;
    z-index: 2;
    padding: 0 3px;
    background: var(--cae-surface);
    font-family: var(--cae-mono);
    font-size: 7.5px;
    letter-spacing: 0.02em;
}

.force-label--comp {
    color: var(--cae-accent-ink);
}

.force-label--tens {
    color: var(--cae-ok);
}

.dim {
    position: absolute;
    height: 1px;
    background: var(--cae-line-strong);
}

.dim__tick {
    position: absolute;
    width: 1px;
    height: 6px;
    background: var(--cae-line-strong);
}

.dim-label {
    position: absolute;
    left: 108px;
    top: 158px;
    padding: 0 4px;
    background: var(--cae-surface);
    color: var(--cae-muted);
    font-family: var(--cae-mono);
    font-size: 8px;
    letter-spacing: 0.06em;
}

.readout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--cae-line);
}

.readout__row {
    display: grid;
    grid-template-columns: 1fr auto 56px;
    align-items: baseline;
    gap: 8px;
    padding: 5px 9px;
    border-right: 1px solid var(--cae-line);
    border-bottom: 1px solid var(--cae-line);
    font-family: var(--cae-mono);
    font-size: 9px;
}

.readout__row:nth-child(2n) {
    border-right: 0;
}

.readout__row:nth-last-child(-n + 2) {
    border-bottom: 0;
}

.readout__row span {
    color: var(--cae-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.readout__row b {
    color: var(--cae-ink);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
}

.readout__row i {
    color: var(--cae-muted);
    font-size: 8px;
    font-style: normal;
    text-align: right;
}

.readout__row--ok b {
    color: var(--cae-ok);
}

.sheet__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 4px 9px;
    background: var(--cae-surface-2);
    color: var(--cae-muted);
    font-family: var(--cae-mono);
    font-size: 8px;
    letter-spacing: 0.03em;
}

.method {
    color: var(--cae-muted);
    font-family: var(--cae-mono);
    font-size: 11px;
}

.matrix--surfaces td:last-child,
.matrix--bench td:last-child {
    white-space: nowrap;
}

.flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--cae-line-strong);
    background: var(--cae-surface);
}

.flow-step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    padding: 16px 14px;
    border-right: 1px solid var(--cae-line);
}

.flow-step:last-child {
    border-right: 0;
}

.flow-index {
    color: var(--cae-accent-ink);
    font-family: var(--cae-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
}

.flow-step h3 {
    margin: 0;
    font-size: 14px;
}

.flow-step p {
    flex: 1;
    margin: 0 0 6px;
    color: var(--cae-muted);
    font-size: 12.5px;
}

.scope-card {
    padding-top: 16px;
}

.scope-card--in {
    border-top-color: var(--cae-ok);
}

.scope-card--out {
    border-top-color: var(--cae-stop);
}

.scope-card ul {
    margin-top: 8px;
    padding-left: 18px;
}

.scope-card li {
    margin: 4px 0;
    font-size: 13px;
}

.status-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 36px;
    padding: 18px 20px;
    border: 1px solid var(--cae-line-strong);
    border-left: 4px solid var(--cae-accent);
    background: var(--cae-surface);
}

.status-band h2 {
    margin: 6px 0 6px;
    font-size: 19px;
}

.status-band p {
    max-width: 720px;
    margin: 0;
    color: var(--cae-muted);
    font-size: 13.5px;
}

@media (max-width: 980px) {
    .hero {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .sheet {
        max-width: 460px;
    }

    .flow {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .flow-step:nth-child(2) {
        border-right: 0;
    }

    .flow-step:nth-child(-n + 2) {
        border-bottom: 1px solid var(--cae-line);
    }
}

@media (max-width: 620px) {
    .hero h1 {
        font-size: 27px;
    }

    .spec__row {
        grid-template-columns: 1fr;
        gap: 1px;
    }

    .flow {
        grid-template-columns: 1fr;
    }

    .flow-step {
        border-right: 0;
        border-bottom: 1px solid var(--cae-line);
    }

    .flow-step:last-child {
        border-bottom: 0;
    }
}

@media (max-width: 380px) {
    .draw__canvas {
        transform: scale(0.92);
        transform-origin: top center;
    }
}
</style>

<script client>
